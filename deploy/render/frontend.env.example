# Public build setting only. No credentials, bucket endpoints or private URLs here.
# Replace with the real backend HTTPS origin, WITHOUT /api or trailing slash.
VITE_API_BASE_URL=https://replace-backend.onrender.com
# Kakao Maps JavaScript app key (public at runtime; restrict it to the registered Web site domains in the Kakao developer console).
# Set the real value only in the Render dashboard, never in this file.
VITE_KAKAO_MAP_KEY=
