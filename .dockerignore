# Deny by default: neither CSV/Excel/PNG/reports nor host credentials enter a build.
**
!backend/
!backend/Dockerfile
!backend/requirements.docker.txt
!backend/chargegap_api/
!backend/chargegap_api/**
!frontend/
!frontend/Dockerfile
!frontend/nginx.conf
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**

# Defense in depth, even if unexpected artifacts appear in allowed source folders.
**/.env
**/.env.*
**/.git
**/.git/**
**/.venv
**/.venv/**
**/node_modules
**/node_modules/**
**/__pycache__
**/__pycache__/**
**/*.pyc
**/*.log
**/*.csv
**/*.xlsx
**/*.xls
**/*.pem
**/*.key
**/credentials*.json
**/service-account*.json
**/service-key*
**/service_key*
**/api-key*
**/api_key*
**/.npmrc
**/.pypirc
**/secrets
**/secrets/**
**/venv
**/venv/**
**/.pytest_cache
**/.pytest_cache/**
**/*.tsbuildinfo
**/*.tmp
**/*.bak
